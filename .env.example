# ---------------------------------------------------------------------------
# Oddsmith environment configuration
# Copy this file to `.env` and fill in your real keys. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- The Odds API (https://the-odds-api.com, v4) ---
# Get a key from your the-odds-api.com dashboard.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# Comma-separated bookmaker regions: us, uk, eu, au
THE_ODDS_API_REGIONS=uk,eu

# --- API-Football (v3) ---
# Direct api-sports.io key. If you access via RapidAPI instead, set
# API_FOOTBALL_USE_RAPIDAPI=true and API_FOOTBALL_BASE_URL to the RapidAPI host.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_USE_RAPIDAPI=false

# --- App ---
# Local Docker Postgres (default). To use Supabase instead, set DATABASE_URL to
# your Supabase connection string (Dashboard > Settings > Database > Connection
# string > URI), using the +psycopg driver, e.g.:
#   postgresql+psycopg://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://oddsmith:oddsmith@localhost:5435/oddsmith
# Source DB for the one-off migration into Supabase (usually the local Docker DB).
MIGRATION_SOURCE_DATABASE_URL=postgresql+psycopg://oddsmith:oddsmith@localhost:5435/oddsmith
DEFAULT_CURRENCY=USD
HTTP_TIMEOUT_SECONDS=15
PROVIDER_CACHE_TTL_SECONDS=60
